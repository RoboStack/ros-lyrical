+# Avoid `git apply` here: source archives may use platform-native line endings,
+# which makes the embedded patch fail to parse on Windows.
+file(READ "${SOURCE_DIR}/CMakeLists.txt" cpptoml_cmake)
+string(REPLACE
+    "cmake_minimum_required(VERSION 3.1.0)"
+    "cmake_minimum_required(VERSION 3.16)"
+    cpptoml_cmake "${cpptoml_cmake}")
+file(WRITE "${SOURCE_DIR}/CMakeLists.txt" "${cpptoml_cmake}")
 
