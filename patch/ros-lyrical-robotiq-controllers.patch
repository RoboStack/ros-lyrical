diff --git a/CMakeLists.txt b/CMakeLists.txt
index 5e955f0..1feb6c6 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,14 @@ find_package(ament_cmake REQUIRED)
 find_package(controller_interface REQUIRED)
 find_package(std_srvs REQUIRED)
 
+# ament_target_dependencies() was removed from ament_cmake_target_dependencies;
+# link against each dependency's exported <pkg>_TARGETS instead.
+macro(link_ament_dependencies target)
+  foreach(_ament_dep ${ARGN})
+    target_link_libraries(${target} ${${_ament_dep}_TARGETS})
+  endforeach()
+endmacro()
+
 set(THIS_PACKAGE_INCLUDE_DEPENDS
   controller_interface
   std_srvs
@@ -25,9 +33,7 @@ target_include_directories(${PROJECT_NAME} PRIVATE
   include
 )
 
-ament_target_dependencies(${PROJECT_NAME}
-  ${THIS_PACKAGE_INCLUDE_DEPENDS}
-)
+link_ament_dependencies(${PROJECT_NAME} ${THIS_PACKAGE_INCLUDE_DEPENDS})
 
 pluginlib_export_plugin_description_file(controller_interface controller_plugins.xml)
 
